{
  "name": "gpt-polisher",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@11.2.2",
  "scripts": {
    "dev": "cd apps/astro && astro dev",
    "build": "astro build --root apps/astro",
    "preview": "cd apps/astro && astro preview",
    "deploy": "pnpm build && wrangler deploy --config apps/astro/dist/server/wrangler.json --autoconfig=false",
    "type-check": "astro check --root apps/astro && tsc --noEmit -p apps/hono",
    "cf-typegen": "wrangler types worker-configuration.d.ts",
    "test": "node --experimental-strip-types --test tests/*.test.ts",
    "test:go": "cd vps/antigravity && go test ./..."
  },
  "dependencies": {
    "@astrojs/cloudflare": "^14.3.0",
    "@astrojs/react": "^6.0.5",
    "@base-ui/react": "^1.7.0",
    "@cloudflare/workers-oauth-provider": "^0.8.1",
    "@modelcontextprotocol/sdk": "1.29.0",
    "@tailwindcss/vite": "^4.3.3",
    "@types/react": "^19.2.18",
    "@types/react-dom": "^19.2.7",
    "agents": "^0.17.1",
    "astro": "^7.3.1",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "hono": "^4.12.27",
    "lucide-react": "^1.40.0",
    "marked": "^18.0.11",
    "react": "^19.2.8",
    "react-dom": "^19.2.8",
    "tailwind-merge": "^3.6.0",
    "tailwindcss": "^4.3.3",
    "tw-animate-css": "^1.4.0",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@astrojs/check": "^0.9.10",
    "@cloudflare/workers-types": "^5.20260903.1",
    "typescript": "6.0.3",
    "wrangler": "^4.128.0"
  }
}
