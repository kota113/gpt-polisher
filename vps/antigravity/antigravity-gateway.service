[Unit]
Description=GPT Polisher Antigravity gateway
Wants=network-online.target
After=network-online.target

[Service]
Type=simple
WorkingDirectory=%h/gpt-polisher/vps/antigravity
EnvironmentFile=%h/.config/gpt-polisher/antigravity.env
ExecStart=%h/gpt-polisher/vps/antigravity/antigravity-gateway
Environment=PATH=%h/.local/bin:%h/.local/go/bin:/usr/local/bin:/usr/bin:/bin
Restart=on-failure
RestartSec=5
TimeoutStopSec=15
NoNewPrivileges=true
PrivateTmp=true

[Install]
WantedBy=default.target
